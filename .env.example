# Chave da API Anthropic (ou use `ant auth login` e deixe vazio)
ANTHROPIC_API_KEY=

# Porta do hub WebSocket
ARO_PORT=7777

# ── Cérebro ────────────────────────────────────────────────────
# Roteamento: cada tier tem modelo + esforço (low | medium | high | xhigh | max)
ARO_MODEL_FAST=claude-sonnet-5
ARO_EFFORT_FAST=low
ARO_MODEL_MAIN=claude-opus-5
ARO_EFFORT_MAIN=medium
ARO_MODEL_DEEP=claude-opus-5
ARO_EFFORT_DEEP=high
# Turno de voz que cairia no main: modelo/esforço próprios (Opus pensando demora demais pra fala)
ARO_MODEL_VOICE=claude-sonnet-5
ARO_EFFORT_VOICE=low

# Classificador (decide o tier quando as regras não batem)
ARO_MODEL_CLASSIFIER=claude-haiku-4-5

# Força um tier (debug): fast | main | deep — vazio = automático
ARO_ROUTER=

# TTL do prompt cache: 1h (uso esporádico ao longo do dia) | 5m (conversa contínua)
ARO_CACHE_TTL=1h

# Cidade padrão pro clima
ARO_CITY=Goiânia

# ── ElevenLabs ─────────────────────────────────────────────────
# Com chave: ouvido = Scribe Realtime (streaming) e boca = Flash. Sem chave: Whisper + Edge.
ELEVENLABS_API_KEY=
# Voz (id da biblioteca, sotaque brasileiro). Ale Garcia = kd1lRcSdRGIfyKxQKjmH · Davi = 5p9IbzcK4R8rN1fpGdMF · Roberta = RGymW84CSmfVugnA5tvA
ARO_ELEVEN_VOICE=kd1lRcSdRGIfyKxQKjmH
# flash_v2_5 = ~0.45s até o 1º áudio. v3 soa mais expressivo mas leva segundos e não aceita previous_text
ARO_ELEVEN_MODEL=eleven_flash_v2_5
# Força motor: ARO_STT=whisper | elevenlabs · ARO_TTS=elevenlabs | edge | kokoro

# ── Ouvido (apps/voice) ────────────────────────────────────────
# Whisper: large-v3-turbo | medium | small. Device: auto | cuda | cpu
ARO_WHISPER_MODEL=large-v3-turbo
ARO_WHISPER_DEVICE=auto
# Beam menor = mais rápido (1-5). Prompt = seu vocabulário, ajuda o Whisper a acertar nomes
ARO_WHISPER_BEAM=1
ARO_WHISPER_PROMPT=Conversa em portugues do Brasil com o ARO, assistente do Ighor. Disrupty, TypeScript, Next.js, Electron, deploy, commit.

# Nível mínimo (RMS) que conta como voz. Wake não pega? Desce (0.004). Dispara com barulho? Sobe (0.01)
ARO_MIC_MIN_LEVEL=0.006

# Silêncio (ms) que encerra a gravação
ARO_SILENCE_MS=500
# Ativou e ninguém falou: segundos até desistir (e a janela voltar pro canto)
ARO_NO_SPEECH_S=4

# Dispositivos de áudio por parte do nome (ex: HyperX). Vazio = padrão do Windows
ARO_INPUT_DEVICE=
ARO_OUTPUT_DEVICE=

# Log da voz: info | debug
ARO_LOG=info

# Bipes: subindo ao começar a ouvir (wake word), descendo ao terminar
ARO_CHIME=on

# ── Boca ───────────────────────────────────────────────────────
# Motor sem ElevenLabs: edge (Microsoft neural, precisa internet; Kokoro assume se cair) | kokoro (100% local)
# Vozes PT-BR: pt-BR-AntonioNeural | pt-BR-FranciscaNeural | pt-BR-ThalitaMultilingualNeural
# Multilíngues que falam PT: en-US-AndrewMultilingualNeural | en-US-BrianMultilingualNeural
ARO_EDGE_VOICE=pt-BR-AntonioNeural
ARO_EDGE_RATE=+12%
ARO_EDGE_PITCH=+0Hz

# Kokoro (fallback): pf_dora (fem) | pm_alex | pm_santa
ARO_TTS_VOICE=pm_alex
ARO_TTS_SPEED=1.05

# always = fala toda resposta | voice = só fala quando você falou
ARO_SPEAK=always

# Barge-in por voz: você fala enquanto ele fala → ele cala e ouve.
# Com caixa de som deixa off (ele se escutaria). Com fone, on.
ARO_BARGE_IN=off
ARO_BARGE_IN_LEVEL=0.45
ARO_BARGE_IN_MS=350

# Wake word: fala "ARO" pra ativar (detector = Whisper base na GPU, ~270ms)
ARO_WAKE=on
ARO_WAKE_MODEL=base
ARO_WAKE_WORDS=aro,arô

# Conversa contínua: depois de responder, fica ouvindo esse tanto de segundos (0 = off)
ARO_FOLLOW_UP_S=4

# Fillers falados enquanto pensa em pergunta pesada (separados por |; vazio = off)
ARO_FILLERS=Deixa eu ver.|Um segundo.|Deixa eu pensar.

# Thinking no tier rápido (off = responde na hora; on = mostra o azul pensando)
ARO_FAST_THINKING=off
